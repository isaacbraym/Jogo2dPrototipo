{
  "name": "viva-simulador-de-vida",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VIVA — simulador de vida 2D com personagens modulares procedurais",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && tsx scripts/check-content.ts",
    "check:quick": "tsx scripts/check-content.ts --quick",
    "catalog": "tsx scripts/catalog.ts",
    "painel": "vite --port 5199 --open /painel.html"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
